# --- Preset A: OpenRouter ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-your-key
TRIAGE_MODEL=openai/gpt-4o-mini
ANSWER_MODEL=openai/gpt-4o
JUDGE_MODEL=openai/gpt-4o

# --- Preset B: local Ollama (any non-empty key works) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# TRIAGE_MODEL=llama3.2:3b
# ANSWER_MODEL=llama3.1:8b
# JUDGE_MODEL=llama3.1:8b

# --- Preset C: MiniMax (official API, OpenAI-compatible) ---
# Paste your MiniMax key into LLM_API_KEY below, uncomment these 5 lines,
# and comment out Preset A above. List available models with:
#   curl https://api.minimax.io/v1/models -H "Authorization: Bearer $LLM_API_KEY"
# LLM_BASE_URL=https://api.minimax.io/v1
# LLM_API_KEY=your-minimax-key
# TRIAGE_MODEL=MiniMax-M2
# ANSWER_MODEL=MiniMax-M2
# JUDGE_MODEL=MiniMax-M2

# Offline deterministic fake model (no key needed). Tests always force this.
# LLM_FAKE=1

# Portfolio API
PORTFOLIO_API_URL=http://localhost:8210
# API_OVERHEAD_MS=80
# API_LATENCY_MS_PER_1K_ROWS=15
# FAIL_RATE=0.3

# Agent v2 flags (all default on): CACHE DIRECT_TOOLS COMPACT MODEL_PER_ROLE STREAMING

# Change set 3 (deploy/): token the web-gateway requires in X-Demo-Token
DEMO_TOKEN=demo-token
# Debug console on the advisor (local dev only). COST_PER_CALL_USD is illustrative, not a price.
# ADVISOR_DEBUG=0
# COST_PER_CALL_USD=0.002
